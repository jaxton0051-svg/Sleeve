# Sleeve — local secrets
#
# Copy this file to `.env` and fill in the values you have. Anything
# left blank is silently skipped — the corresponding provider is just
# disabled in the multi-source aggregator.
#
# The .env file is loaded once at app startup via python-dotenv.

# Set to 1 when HTTPS is terminated by a reverse proxy in front of Sleeve.
SLEEVE_COOKIE_SECURE=

# Optional local SearXNG instance used for YouTube search/thumbnail lookup.
# Leave blank to use yt-dlp search fallback where supported.
SEARXNG_URL=

# ---------------------------------------------------------------- Spotify
# Create an app at https://developer.spotify.com/dashboard and copy the
# Client ID + Client Secret from "App settings". The app uses the
# server-to-server "Client Credentials" OAuth flow (no user login).
# Leave both blank to skip Spotify entirely.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
